<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>FanHive</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- 通信はHTTPSだけ＝輸出規制の免除対象。入れておくとアップロードのたびに
	     暗号化の確認ダイアログが出なくなる（提出時の申告「標準的な暗号化のみ」と同じ内容）。 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- 端末カレンダー。listCalendars / listEventsInRange / deleteEventsById を使う（重複を掃除するため
	     既存の予定を読む）ので書き込み専用では足りず、フルアクセスが要る。
	     iOS 17以降は FullAccess、16以前は NSCalendarsUsageDescription を見る。
	     この文言はそのまま許可ダイアログに出る。目的が曖昧だと審査 5.1.1 で落ちる。 -->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>保存した発売日・イベントの予定を、あなたのカレンダーアプリに書き込むために使います。重複した予定を整理するため、FanHiveが作成した予定の読み取りも行います。</string>
	<key>NSCalendarsUsageDescription</key>
	<string>保存した発売日・イベントの予定を、あなたのカレンダーアプリに書き込むために使います。重複した予定を整理するため、FanHiveが作成した予定の読み取りも行います。</string>
	<!-- カレンダーの背景画像を選ぶための写真ライブラリ。
	     カメラは使わないので NSCameraUsageDescription は入れない（入れる＝カメラを開く経路が
	     残っているということ）。写真の選択は Camera プラグインの pickImages で
	     iOS標準の PHPicker を開く。HTMLの <input type="file" accept="image/*"> は iOS では
	     「Take Photo」を必ず出してしまい、用途説明の無いカメラ起動でアプリが落ちるため使わない。
	     ピッカーを出す前に PHPhotoLibrary.requestAuthorization が走るので、
	     この文言はそのまま許可ダイアログに出る。 -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>カレンダーの背景画像に使う写真を選ぶために使います。選んだ写真だけを読み込み、他の写真は読み取りません。</string>
	<!-- 広告のトラッキング許可(ATT)。AdMob を出す前に必ず要る。
	     許可しなくても広告は出る（パーソナライズされないだけ）。 -->
	<key>NSUserTrackingUsageDescription</key>
	<string>あなたの興味に合った広告を表示するために使います。許可しなくてもFanHiveのすべての機能をお使いいただけます。</string>
	<!-- 値下げ・再入荷・受付開始のプッシュ通知 -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- AdMob の iOS アプリID（Androidとは別のアプリとして登録されている）。
	     このキーが無い/不正だと GoogleMobileAds SDK は起動時に例外を投げてアプリが落ちる。 -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-3561970163550872~5475667425</string>
	<!-- Share Extension から本体を開くためのURLスキーム。
	     拡張機能は別プロセスなので、openURL 以外に本体へ渡す手段がない。 -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>jp.llp.fanhive</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fanhive</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
