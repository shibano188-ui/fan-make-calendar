# App Store Connect API キー経由で動かす。ブラウザログインは不要。
# キーの配置は setup-asc-key.sh を実行して作る。

default_platform(:ios)

require "json"

ASC_KEY_JSON = File.expand_path("~/.appstoreconnect/fanhive-asc-key.json")

# app_store_connect_api_key は api_key_path を受け付けないので、JSON を自前で読んで渡す。
def asc_key
  unless File.exist?(ASC_KEY_JSON)
    UI.user_error!("APIキーが未設定です。setup-asc-key.sh を実行してください: #{ASC_KEY_JSON}")
  end
  cfg = JSON.parse(File.read(ASC_KEY_JSON))
  app_store_connect_api_key(
    key_id: cfg.fetch("key_id"),
    issuer_id: cfg.fetch("issuer_id"),
    key_content: cfg.fetch("key"),
    is_key_content_base64: false,
    duration: cfg.fetch("duration", 1200),
    in_house: cfg.fetch("in_house", false)
  )
end

platform :ios do
  desc "アプリの現在の状態（バージョン・審査ステータス・ビルド）を表示"
  lane :info do
    asc_key
    app = Spaceship::ConnectAPI::App.find(
      CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    )
    UI.message("App: #{app.name} (#{app.id})")
    app.get_app_store_versions.first(5).each do |v|
      UI.message("  version #{v.version_string.ljust(8)} #{v.app_store_state}")
    end
    app.get_builds.first(5).each do |b|
      UI.message("  build   #{b.version.ljust(8)} #{b.processing_state}")
    end
  end

  desc "App Store の現在のスクリーンショットを fastlane/screenshots/ に取得"
  lane :screenshots_download do
    deliver(
      api_key: asc_key,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      force: true
    )
  end

  desc "fastlane/screenshots/ の内容を App Store に反映（ロケール単位で全置換）"
  lane :screenshots_upload do
    UI.important("deliver はロケール単位で全置換します。screenshots/ja/ に最終的に載せたい全枚数が揃っているか確認してください。")
    deliver(
      api_key: asc_key,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true,
      run_precheck_before_submit: false
    )
  end

  desc "アーカイブだけする（送信はしない）"
  lane :archive do
    build_app(scheme: "App", export_method: "app-store", output_directory: "build")
  end

  desc "アーカイブ済みの build/App.ipa を TestFlight へ送る"
  lane :upload do
    upload_to_testflight(
      api_key: asc_key,
      ipa: "build/App.ipa",
      skip_waiting_for_build_processing: false
    )
  end

  desc "指定ビルドを 1.0 に紐付けて審査に提出（例: fastlane submit build:8）"
  lane :submit do |options|
    deliver(
      api_key: asc_key,
      build_number: options[:build],
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      submission_information: {
        # 暗号化: Info.plist の ITSAppUsesNonExemptEncryption=false と同じ回答
        export_compliance_uses_encryption: false,
        # AdMobの広告を出すので IDFA を使う。許可はATTで取る
        add_id_info_uses_idfa: true,
        add_id_info_serves_ads: true,
        add_id_info_tracks_action: false,
        add_id_info_tracks_install: false,
        add_id_info_limits_tracking: true
      }
    )
  end

  desc "アーカイブして TestFlight へ送信"
  lane :beta do
    build_app(
      scheme: "App",
      export_method: "app-store",
      output_directory: "build"
    )
    upload_to_testflight(
      api_key: asc_key,
      skip_waiting_for_build_processing: true
    )
  end
end
